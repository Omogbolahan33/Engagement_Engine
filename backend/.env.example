# ============================================================
# Engagement Platform - Backend Environment Configuration
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engagement_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-in-production-use-at-least-64-characters-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption Key (32 bytes for AES-256) - CHANGE IN PRODUCTION
ENCRYPTION_KEY=change-me-32-byte-key-for-aes-256!!
# Key version new ciphertext is written with.
ENCRYPTION_KEY_VERSION=1
# Retired keys kept only so existing rows stay readable during a rotation.
# JSON map of version -> key, e.g. {"1":"the-previous-32-byte-key-goes-here"}
# Rotation procedure:
#   1. put the current key here under its version
#   2. set ENCRYPTION_KEY to the new key and bump ENCRYPTION_KEY_VERSION
#   3. POST /api/v1/security/rotate-keys until pending reaches 0
#   4. remove the old key from this map
ENCRYPTION_KEYS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Worker
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=5000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@engagement-platform.com

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000
SESSION_EXPIRY_MS=86400000

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE=
PUPPETEER_PROXY=

# Meta (Facebook/Instagram/Threads) OAuth
# Create a Meta App at https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/v1/oauth/meta/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000
